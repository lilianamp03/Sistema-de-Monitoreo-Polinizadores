[Unit]
Description=Sistema de monitoreo con YOLO11s y MOG2
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Desktop/Monitoreo
ExecStart=/usr/bin/python3 -u /home/pi/Desktop/Monitoreo/Monitoreo_YOLO.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
